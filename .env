# Automotive Document Intelligence System - Environment Configuration

# =============================================
# REQUIRED SETTINGS
# =============================================

# Google AI API Key (REQUIRED)
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSyADfqdQk44kB2-g68MRclAQLjFKfdpjXFQ

# =============================================
# APPLICATION SETTINGS
# =============================================

# Application environment (development, staging, production)
ENVIRONMENT=development

# Port for the FastAPI server
PORT=8000

# Debug mode (true/false)
DEBUG=false

# =============================================
# VECTOR DATABASE SETTINGS
# =============================================

# Directory to persist ChromaDB data
CHROMA_PERSIST_DIR=./chroma_db

# Embedding model for text vectorization
# Options: all-MiniLM-L6-v2, all-mpnet-base-v2, etc.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================
# DOCUMENT PROCESSING SETTINGS
# =============================================

# DPI for PDF image extraction
PDF_DPI=300

# Text chunk size (in tokens/characters)
CHUNK_SIZE=512

# Chunk overlap for context preservation
CHUNK_OVERLAP=50

# Maximum file size for uploads (in MB)
MAX_FILE_SIZE_MB=50

# =============================================
# RAG PIPELINE SETTINGS
# =============================================

# Maximum results to retrieve from vector store
MAX_RETRIEVAL_RESULTS=5

# Minimum similarity threshold for retrieval
MIN_SIMILARITY_THRESHOLD=0.3

# =============================================
# PROCESSING SETTINGS
# =============================================

# Batch size for processing
BATCH_SIZE=10

# Maximum worker threads
MAX_WORKERS=4

# =============================================
# PATH SETTINGS
# =============================================

# Upload directory for PDFs
UPLOAD_DIR=./uploads

# Temporary files directory
TEMP_DIR=./temp

# Log files directory
LOGS_DIR=./logs

# =============================================
# CORS SETTINGS
# =============================================

# Allowed origins (comma-separated, or * for all)
CORS_ORIGINS=*

# =============================================
# RATE LIMITING
# =============================================

# Maximum requests per minute
RATE_LIMIT_PER_MINUTE=60

# =============================================
# LOGGING
# =============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO